#!/bin/bash

# omarchy:summary=Internal color and glyph setup for pkg commands
# omarchy:hidden=true

# Intended to be sourced by omarchy-pkg-* scripts, not executed directly.
# After sourcing, the following are set:
#   USE_COLOR  — "true" when stdout is a TTY and colors.toml exists
#   C_ACCENT, C_GREEN, C_RED, C_MUTED, C_FG  — ANSI 24-bit fg sequences (or "")
#   RESET      — ANSI reset sequence (or "")
#   GLYPH_PKG, GLYPH_OK, GLYPH_FAIL  — nerd font glyphs

_PKG_COLORS_TOML="${HOME}/.local/state/omarchy/current/theme/colors.toml"
USE_COLOR=false
[[ -t 1 && -f $_PKG_COLORS_TOML ]] && USE_COLOR=true

_pkg_read_color() {
  local key="$1"
  awk -F= -v key="$key" '
    function clean(raw) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", raw)
      if (raw ~ /^"/) { sub(/^"/, "", raw); sub(/".*$/, "", raw) }
      return raw
    }
    { field = $1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", field)
      if (field == key) { print clean($2); exit } }
  ' "$_PKG_COLORS_TOML"
}

_pkg_ansi_fg() {
  local hex="${1#\#}"
  printf '\033[38;2;%d;%d;%dm' \
    "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

if [[ $USE_COLOR == "true" ]]; then
  C_ACCENT=$(_pkg_ansi_fg "$(_pkg_read_color accent)")
  C_GREEN=$(_pkg_ansi_fg "$(_pkg_read_color green)")
  C_RED=$(_pkg_ansi_fg "$(_pkg_read_color red)")
  C_MUTED=$(_pkg_ansi_fg "$(_pkg_read_color muted)")
  C_FG=$(_pkg_ansi_fg "$(_pkg_read_color foreground)")
  RESET=$'\033[0m'
else
  C_ACCENT="" C_GREEN="" C_RED="" C_MUTED="" C_FG="" RESET=""
fi

GLYPH_PKG="󰏖"
GLYPH_OK=""
GLYPH_FAIL=""

# Filter a single nixos-rebuild progress line: suppress noise, translate
# semantic events to summary lines.  Call once per line in verbose mode.
# Uses globals: C_ACCENT, RESET, GLYPH_PKG, _PKG_BUILDING_SHOWN
_PKG_BUILDING_SHOWN=false
_pkg_filter_rebuild_line() {
  local line="$1"

  # Suppress high-volume store-path noise
  [[ $line =~ ^"unpacking '" ]] && return
  [[ $line =~ ^"copying path " ]] && return
  [[ $line =~ ^[[:space:]]*/nix/store/ ]] && return
  [[ $line =~ ^"these "[0-9]+" derivations will be built" ]] && return
  [[ $line =~ ^"these "[0-9]+" paths will be fetched" ]] && return
  [[ $line =~ ^"these "[0-9]+" paths will be copied" ]] && return
  [[ $line =~ ^"querying info" ]] && return
  [[ -z $line ]] && return

  # Translate semantic events into one-line summaries
  if [[ $line =~ "building the system configuration" ]]; then
    printf '%b%s Resolving dependencies\xe2\x80\xa6%b\n' "$C_ACCENT" "$GLYPH_PKG" "$RESET"
    return
  fi
  if [[ $line =~ "activating the configuration" ]]; then
    printf '%b%s Activating configuration\xe2\x80\xa6%b\n' "$C_ACCENT" "$GLYPH_PKG" "$RESET"
    return
  fi
  if [[ $line =~ ^"building '" ]]; then
    if [[ $_PKG_BUILDING_SHOWN == "false" ]]; then
      printf '%b%s Building packages\xe2\x80\xa6%b\n' "$C_ACCENT" "$GLYPH_PKG" "$RESET"
      _PKG_BUILDING_SHOWN=true
    fi
    return
  fi

  echo "$line"
}
