#!/bin/bash

# omarchy:summary=Remove a package
# omarchy:args=[--verbose] <package>
# omarchy:examples=omarchy pkg drop git

verbose=false
pkg=""
for arg in "$@"; do
  case "$arg" in
    --verbose|-v) verbose=true ;;
    -*) echo "Unknown flag: $arg" >&2; exit 1 ;;
    *) pkg="$arg" ;;
  esac
done

[[ -z $pkg ]] && { echo "Usage: omarchy-pkg-drop [--verbose] <package>" >&2; exit 1; }

# shellcheck source=omarchy-pkg-colors
source omarchy-pkg-colors

if ! socat -u /dev/null UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; then
  echo "omarchy: daemon not reachable at /run/omarchy/daemon.sock" >&2
  exit 1
fi

if [[ $verbose == "false" ]]; then
  # ── FAST PATH ─────────────────────────────────────────────────────────────
  # Phase 1: remove from nix profile immediately; suppress output.
  # Ignore errors: the profile entry may not exist if the package was installed
  # before the fast-path was introduced or was already cleaned up after a rebuild.
  nix --extra-experimental-features 'nix-command flakes' \
    profile remove "nixpkgs#${pkg}" >/dev/null 2>&1 || true

  # Phase 2: signal daemon to update state.json and queue async rebuild.
  coproc DAEMON { socat - UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; }
  printf '{"cmd":"pkg-drop-async","name":"%s"}\n' "$pkg" >&"${DAEMON[1]}"

  ok=false
  err_msg="daemon error"
  while IFS= read -r frame <&"${DAEMON[0]}"; do
    ok=$(printf '%s' "$frame" | jq -r '.ok // false')
    err_msg=$(printf '%s' "$frame" | jq -r '.error // "daemon error"')
    break
  done
  exec {DAEMON[1]}>&-
  wait "$DAEMON_PID" 2>/dev/null

  if [[ $ok == "true" ]]; then
    printf '%b%s %s removed (system sync in progress\xe2\x80\xa6)%b\n' \
      "$C_GREEN" "$GLYPH_OK" "$pkg" "$RESET"
  else
    printf '%b%s %s%b\n' "$C_RED" "$GLYPH_FAIL" "$err_msg" "$RESET" >&2
    exit 1
  fi

else
  # ── VERBOSE / SYNC PATH ───────────────────────────────────────────────────
  # Blocks until the rebuild completes; streams filtered progress to the terminal.
  coproc DAEMON { socat - UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; }
  printf '{"cmd":"pkg-remove","name":"%s"}\n' "$pkg" >&"${DAEMON[1]}"

  exit_code=0
  err_msg=""
  _PKG_BUILDING_SHOWN=false
  while IFS= read -r frame <&"${DAEMON[0]}"; do
    type=$(printf '%s' "$frame" | jq -r '.type // empty')
    if [[ $type == "progress" ]]; then
      _pkg_filter_rebuild_line "$(printf '%s' "$frame" | jq -r '.line')"
    else
      ok=$(printf '%s' "$frame" | jq -r '.ok // false')
      if [[ $ok != "true" ]]; then
        err_msg=$(printf '%s' "$frame" | jq -r '.error // "unknown error"')
        exit_code=1
      fi
      break
    fi
  done
  exec {DAEMON[1]}>&-
  wait "$DAEMON_PID" 2>/dev/null

  if (( exit_code == 0 )); then
    printf '%b%s %s removed%b\n' "$C_GREEN" "$GLYPH_OK" "$pkg" "$RESET"
  else
    printf '%b%s rebuild failed: %s%b\n' "$C_RED" "$GLYPH_FAIL" "$err_msg" "$RESET" >&2
    exit 1
  fi
fi
