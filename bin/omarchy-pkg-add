#!/bin/bash

# omarchy:summary=Add a package
# omarchy:args=[--async] <package>
# omarchy:examples=omarchy pkg add git

async=false
pkg=""
for arg in "$@"; do
  case "$arg" in
    --async) async=true ;;
    -*) echo "Unknown flag: $arg" >&2; exit 1 ;;
    *) pkg="$arg" ;;
  esac
done

[[ -z $pkg ]] && { echo "Usage: omarchy-pkg-add [--async] <package>" >&2; exit 1; }

# shellcheck source=omarchy-pkg-colors
source omarchy-pkg-colors

if ! socat -u /dev/null UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; then
  echo "omarchy: daemon not reachable at /run/omarchy/daemon.sock" >&2
  exit 1
fi

# ── Phase 1: install to nix profile so the package is usable immediately ──────
if ! nix_err=$(nix --extra-experimental-features 'nix-command flakes' \
    profile install "nixpkgs#${pkg}" 2>&1); then
  printf '%b%s package not found or install failed: %s%b\n' \
    "$C_RED" "$GLYPH_FAIL" "$pkg" "$RESET" >&2
  printf '%bSearch with: nix search nixpkgs %s%b\n' "$C_MUTED" "$pkg" "$RESET" >&2
  exit 1
fi

printf '%b%s %s installed%b\n' "$C_GREEN" "$GLYPH_OK" "$pkg" "$RESET"

if [[ $async == "true" ]]; then
  # ── ASYNC MODE: signal daemon and exit; notification arrives when done ──────
  coproc DAEMON { socat - UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; }
  printf '{"cmd":"pkg-add-async","name":"%s"}\n' "$pkg" >&"${DAEMON[1]}"

  ok=false
  err_msg="daemon error"
  while IFS= read -r frame <&"${DAEMON[0]}"; do
    ok=$(printf '%s' "$frame" | jq -r '.ok // false')
    err_msg=$(printf '%s' "$frame" | jq -r '.error // "daemon error"')
    break
  done
  exec {DAEMON[1]}>&-
  wait "$DAEMON_PID" 2>/dev/null

  if [[ $ok == "true" ]]; then
    printf '%b%s System sync queued in background\xe2\x80\xa6%b\n' \
      "$C_MUTED" "$GLYPH_PKG" "$RESET"
  else
    nix --extra-experimental-features 'nix-command flakes' \
      profile remove "nixpkgs#${pkg}" >/dev/null 2>&1 || true
    printf '%b%s %s%b\n' "$C_RED" "$GLYPH_FAIL" "$err_msg" "$RESET" >&2
    exit 1
  fi
  exit 0
fi

# ── DEFAULT: stream filtered rebuild progress (package already usable above) ──
printf '%b%s Syncing system config\xe2\x80\xa6%b\n' "$C_ACCENT" "$GLYPH_PKG" "$RESET"

coproc DAEMON { socat - UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; }
printf '{"cmd":"pkg-add","name":"%s"}\n' "$pkg" >&"${DAEMON[1]}"

exit_code=0
err_msg=""
_PKG_BUILDING_SHOWN=false
while IFS= read -r frame <&"${DAEMON[0]}"; do
  type=$(printf '%s' "$frame" | jq -r '.type // empty')
  if [[ $type == "progress" ]]; then
    _pkg_filter_rebuild_line "$(printf '%s' "$frame" | jq -r '.line')"
  else
    ok=$(printf '%s' "$frame" | jq -r '.ok // false')
    if [[ $ok != "true" ]]; then
      err_msg=$(printf '%s' "$frame" | jq -r '.error // "unknown error"')
      exit_code=1
    fi
    break
  fi
done
exec {DAEMON[1]}>&-
wait "$DAEMON_PID" 2>/dev/null

if (( exit_code == 0 )); then
  # Package is now in the system config — remove the redundant profile entry.
  nix --extra-experimental-features 'nix-command flakes' \
    profile remove "nixpkgs#${pkg}" >/dev/null 2>&1 || true
  printf '%b%s System sync complete%b\n' "$C_GREEN" "$GLYPH_OK" "$RESET"
else
  # Rebuild failed — keep the profile entry so the package stays usable.
  printf '%b%s System sync failed: %s%b\n' "$C_RED" "$GLYPH_FAIL" "$err_msg" "$RESET" >&2
  if [[ $err_msg =~ attribute|undefined|"does not exist" ]]; then
    printf '%bSearch with: nix search nixpkgs %s%b\n' "$C_MUTED" "$pkg" "$RESET" >&2
  fi
  printf '%bPackage stays usable. Retry with: omarchy pkg sync%b\n' \
    "$C_MUTED" "$RESET" >&2
  exit 1
fi
