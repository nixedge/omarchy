#!/bin/bash

# omarchy:summary=Add a package
# omarchy:args=<package>
# omarchy:examples=omarchy pkg add git

[[ -z $1 ]] && { echo "Usage: omarchy-pkg-add <package>" >&2; exit 1; }

pkg="$1"

response=$(printf '{"cmd":"pkg-add","name":"%s"}\n' "$pkg" \
  | socat - UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null)

if [[ -z $response ]]; then
  echo "omarchy: daemon not reachable at /run/omarchy/daemon.sock" >&2
  exit 1
fi

ok=$(printf '%s' "$response" | jq -r '.ok')

if [[ $ok != "true" ]]; then
  printf '%s' "$response" | jq -r '.error // "unknown error"' >&2
  exit 1
fi
