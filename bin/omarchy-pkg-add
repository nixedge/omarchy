#!/bin/bash

# omarchy:summary=Add a package
# omarchy:args=<package>
# omarchy:examples=omarchy pkg add git

[[ -z $1 ]] && { echo "Usage: omarchy-pkg-add <package>" >&2; exit 1; }

pkg="$1"

if ! socat -u /dev/null UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; then
  echo "omarchy: daemon not reachable at /run/omarchy/daemon.sock" >&2
  exit 1
fi

# Keep socat's stdin open via coproc so it doesn't close the socket when the
# request is sent.  Close it explicitly after the Done frame arrives.
coproc DAEMON { socat - UNIX-CONNECT:/run/omarchy/daemon.sock 2>/dev/null; }

printf '{"cmd":"pkg-add","name":"%s"}\n' "$pkg" >&"${DAEMON[1]}"

exit_code=0

while IFS= read -r frame <&"${DAEMON[0]}"; do
  type=$(printf '%s' "$frame" | jq -r '.type // empty')
  if [[ $type == "progress" ]]; then
    printf '%s' "$frame" | jq -r '.line'
  else
    ok=$(printf '%s' "$frame" | jq -r '.ok // false')
    if [[ $ok != "true" ]]; then
      printf '%s' "$frame" | jq -r '.error // "unknown error"' >&2
      exit_code=1
    fi
    break
  fi
done

exec {DAEMON[1]}>&-
wait "$DAEMON_PID" 2>/dev/null

exit $exit_code
