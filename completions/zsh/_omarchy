#compdef omarchy

_omarchy() {
  local json
  json=$(omarchy commands --json 2>/dev/null) || return

  local curcontext="$curcontext" state line
  _arguments -C \
    '1: :->group' \
    '2: :->subcommand' \
    '*: :'

  case $state in
    group)
      local -a groups
      groups=(${(f)"$(printf '%s' "$json" \
        | jq -r '[.commands[].group] | unique | .[]')"})
      _values 'group' $groups
      ;;
    subcommand)
      local -a subcmds
      subcmds=(${(f)"$(printf '%s' "$json" \
        | jq -r --arg g "${words[2]}" \
            '[.commands[] | select(.group == $g and .name != "") | .name + ":" + .summary]
             | unique | .[]')"})
      _describe 'subcommand' subcmds
      ;;
  esac
}

_omarchy
