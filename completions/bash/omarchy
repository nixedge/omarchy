_omarchy() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local json
  json=$(omarchy commands --json 2>/dev/null) || return

  if (( COMP_CWORD == 1 )); then
    COMPREPLY=($(compgen -W \
      "$(jq -r '[.commands[].group] | unique | .[]' <<< "$json")" \
      -- "$cur"))
  elif (( COMP_CWORD == 2 )); then
    local group="${COMP_WORDS[1]}"
    COMPREPLY=($(compgen -W \
      "$(jq -r --arg g "$group" \
         '[.commands[] | select(.group == $g and .name != "") | .name] | unique | .[]' \
         <<< "$json")" \
      -- "$cur"))
  fi
}

complete -F _omarchy omarchy
